{
  "name": "parea",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "tests/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @parea/core",
    "mail:test": "tsx scripts/send-test-email.ts",
    "sms:test": "tsx scripts/send-test-sms.ts"
  },
  "devDependencies": {
    "react": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
