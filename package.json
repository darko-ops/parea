{
  "name": "parea",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "tests/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @parea/core"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
