{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ../../packages/cards ../../packages/core ../../packages/push ../../packages/upload ../../packages/urls ../../packages/zip ../../package.json ../../package-lock.json ../../.nvmrc ../../.vercelignore ../../scripts/migrate-on-deploy.mjs || exit 1",
  "crons": [
    {
      "path": "/api/cron/start-jobs",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/jobs-heartbeat",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/safety-deadlines",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/derive-backlog",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/requeue-stranded",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/upload-failures",
      "schedule": "0 * * * *"
    }
  ]
}
