{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/jobs-heartbeat",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/safety-deadlines",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/cron/derive-backlog",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/requeue-stranded",
      "schedule": "50 * * * *"
    }
  ]
}
