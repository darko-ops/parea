# Required. Any long random string; rotating it invalidates all cookies.
SESSION_SECRET=

# Postgres (Neon in production).
DATABASE_URL=postgres://localhost:5432/parea

# Cloudflare R2. Leave unset in development and photos go to ./.storage
# via the dev-only object endpoint. Production refuses to start without them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Used to build dev presigned URLs.
APP_URL=http://localhost:3000

# Where the zip Worker is deployed. Downloads are minted as URLs pointing here.
ZIP_BASE_URL=https://parea-zip.example.workers.dev
# Shared with the Worker (`wrangler secret put MANIFEST_SECRET`).
# Falls back to SESSION_SECRET in development.
MANIFEST_SECRET=

# Where the image Worker is deployed. Without it, image URLs are presigned
# per request — correct, but the CDN cache never hits.
IMAGE_BASE_URL=
# Shared with the image Worker (`wrangler secret put IMAGE_SECRET`).
IMAGE_SECRET=

# Published on /safety. App Store Guideline 1.2 requires a way to reach the
# developer for an app carrying user-generated content.
SAFETY_CONTACT_EMAIL=

# Deep links. While these are unset the two .well-known files 404, so iOS and
# Android never verify the app's claim on the domain and every tapped link
# opens a browser instead of the app. Comma-separated for Android: the upload
# key and the key Google re-signs with under Play App Signing.
APPLE_TEAM_ID=
ANDROID_CERT_FINGERPRINTS=

# Sign-in codes (design §3). Accounts are optional, so these are too — but an
# app that offers sign-in and cannot send is worse than one that does not, so
# in production an unconfigured mailer refuses rather than dropping codes.
# Unset locally, the code is printed to the console instead of being sent.
#
# resend | postmark | sendgrid | mailgun. Defaults to resend. A name no
# transport exists for is reported by /api/health rather than discovered when
# nobody receives anything.
MAIL_PROVIDER=
MAIL_API_KEY=
# The address the code comes from, at a domain verified with the provider.
# Most providers reject anything else with a 422.
MAIL_FROM=
# Only needed to override the provider's endpoint — an EU region, or Mailgun,
# whose path carries the sending domain:
# https://api.mailgun.net/v3/<domain>/messages
MAIL_API_URL=

# Prove it before trusting it. Nothing else in the system will tell you:
#   npm run mail:test -- you@example.com
