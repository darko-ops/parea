{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ORG": "parea-kc",
        "SENTRY_PROJECT": "parea-mobile"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "channel": "development-simulator"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.parea.photos",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ORG": "parea-kc",
        "SENTRY_PROJECT": "parea-mobile",
        "EXPO_PUBLIC_SENTRY_DSN": "https://ca7ff6a6e1c8b636573d04b7d1d621b7@o4511939672539136.ingest.us.sentry.io/4512184274845696"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.parea.photos",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ORG": "parea-kc",
        "SENTRY_PROJECT": "parea-mobile",
        "EXPO_PUBLIC_SENTRY_DSN": "https://ca7ff6a6e1c8b636573d04b7d1d621b7@o4511939672539136.ingest.us.sentry.io/4512184274845696"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "${secrets.APPLE_ID}",
        "ascAppId": "${secrets.ASC_APP_ID}",
        "appleTeamId": "${secrets.APPLE_TEAM_ID}"
      },
      "android": {
        "serviceAccountKeyPath": "${secrets.GOOGLE_SERVICE_ACCOUNT_KEY_PATH}",
        "track": "internal"
      }
    }
  }
}
