# Copy to `.env`. Both keys are optional; the defaults are in the source.
#
# The base URL the app talks to. `App.tsx` falls back to `http://localhost:3000`
# — the Next.js dev server, which is reachable from the iOS simulator and from
# nothing else. Set it to the deployed site to use a phone, or to this machine's
# LAN address to develop against a local server from one.
#
# An EAS build ignores this file: `eas.json` sets the value per profile, so a
# `preview` build is pinned to production whatever is here.
EXPO_PUBLIC_API_URL=https://parea.photos
